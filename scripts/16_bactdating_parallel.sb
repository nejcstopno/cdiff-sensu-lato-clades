#!/bin/bash
#SBATCH --job-name=bdpar
#SBATCH --partition=mb-cpu
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=/home/nejc/cdiff_clades/bdpar_%j.out
set -eo pipefail
source /home/nejc/miniconda3/etc/profile.d/conda.sh
set +u; conda activate pantools; set -u
export R_LIBS_USER=/home/nejc/cdiff_clades/Rlib
cd /home/nejc/cdiff_clades
echo "START $(date)"
for TR in core_f053_subs core_f070_subs clonalframe_f053_subs; do
  for R in 2.5e-9 1.5e-8; do
    Rscript bd_one.R $TR $R > bd_${TR}_${R}.log 2>&1 &
  done
done
wait
echo "END $(date)"
grep -h DONE bd_*.log
