#!/bin/bash
#SBATCH --job-name=cdiff_cover
#SBATCH --partition=mb-cpu
#SBATCH --cpus-per-task=4
#SBATCH --mem=250G
#SBATCH --output=/home/nejc/cdiff_clades/cover_%j.out
set -euo pipefail
source /home/nejc/miniconda3/etc/profile.d/conda.sh
conda activate panaroo
cd /home/nejc/cdiff_clades
echo "START $(date)"
python3 greedy_cover.py derep_edges.tsv /home/nejc/.claude-science-scratch/cdiff_work/lists/qc_passed_ids.txt /home/nejc/.claude-science-scratch/cdiff_work/lists/genome_quality.tsv derep_representatives.tsv
echo "END $(date)"
awk -F'\t' 'NR>1 && $3==1' derep_representatives.tsv | wc -l
