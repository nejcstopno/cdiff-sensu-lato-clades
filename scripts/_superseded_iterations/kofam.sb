#!/bin/bash
#SBATCH --job-name=cdiff_kofam
#SBATCH --partition=mb-cpu
#SBATCH --cpus-per-task=48
#SBATCH --mem=120G
#SBATCH --output=/home/nejc/cdiff_clades/kofam_%j.out
set -euo pipefail
source /home/nejc/miniconda3/etc/profile.d/conda.sh
conda activate prokka   # has hmmer
cd /home/nejc/cdiff_clades
DB=/volumes/homehpc/storage/DB/DRAMv1
hmmsearch --version
echo "START $(date)"
hmmsearch --cpu 48 -Z 1093 --domtblout kofam_hits.domtbl -o /dev/null \
          "$DB/kofam_profiles.hmm" /home/nejc/.claude-science-scratch/cdiff_work/lists/clade_specific_proteins.faa
echo "END $(date)"
wc -l kofam_hits.domtbl
head -3 "$DB/kofam_ko_list.tsv"
