#!/bin/bash
#SBATCH --job-name=pp_install
#SBATCH --partition=mb-cpu
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --output=/home/nejc/cdiff_clades/ppinstall_%j.out
set -euo pipefail
source /home/nejc/miniconda3/etc/profile.d/conda.sh
echo "START $(date)"
conda create -y -n poppunk_new -c conda-forge -c bioconda poppunk 2>&1 | tail -25
conda activate poppunk_new
poppunk --version
python -c "import pp_sketchlib; print('pp_sketchlib ok', pp_sketchlib.version)" 2>&1 | tail -2
echo "END $(date)"
