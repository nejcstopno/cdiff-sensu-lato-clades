#!/bin/bash
#SBATCH --job-name=ttfix3
#SBATCH --partition=mb-cpu
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --output=/home/nejc/cdiff_clades/ttfix3_%j.out
set -eo pipefail
source /home/nejc/miniconda3/etc/profile.d/conda.sh
set +u
conda activate dating_env
set -u
pip uninstall -y PyQt6 PyQt6-Qt6 PyQt6-sip > /tmp/pq.txt 2>&1 || true
tail -2 /tmp/pq.txt
for v in 2025.4 2025.1 2024.2; do
  echo "--- trying treetime==$v ---"
  pip install --no-cache-dir "treetime==$v" > /tmp/tti.txt 2>&1 || true
  tail -2 /tmp/tti.txt
  if python -c "import treetime; print('OK', treetime.version)" 2>/dev/null; then
    echo "WORKING_VERSION $v"; break
  fi
done
treetime --version > /tmp/ttv3.txt 2>&1 || true
cat /tmp/ttv3.txt
python -c "import treetime; print('treetime_import_OK', treetime.version)"
echo "DONE_TTFIX3"
