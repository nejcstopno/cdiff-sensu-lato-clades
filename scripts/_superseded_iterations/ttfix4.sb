#!/bin/bash
#SBATCH --job-name=ttfix4
#SBATCH --partition=mb-cpu
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --output=/home/nejc/cdiff_clades/ttfix4_%j.out
set -eo pipefail
source /home/nejc/miniconda3/etc/profile.d/conda.sh
set +u
conda activate dating_env
set -u
SYSLIB=$CONDA_PREFIX/x86_64-conda-linux-gnu/sysroot/usr/lib64
ln -sf $SYSLIB/libEGL.so.1 $CONDA_PREFIX/lib/libEGL.so.1 || true
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$SYSLIB:${LD_LIBRARY_PATH:-}
pip install --no-cache-dir --force-reinstall "treetime==2026.2" > /tmp/tt4.txt 2>&1 || true
tail -2 /tmp/tt4.txt
treetime --version > /tmp/ttv4.txt 2>&1 || true
cat /tmp/ttv4.txt
python -c "import treetime; print('treetime_import_OK', treetime.version)"
echo "DONE_TTFIX4"
